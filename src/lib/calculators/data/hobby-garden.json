      "faq": [
        {
          "question": "Что относится к зелёному материалу?",
          "answer": "Свежескошенная трава, овощные очистки, кофейная гуща, чайные листья, свежий навоз."
        },
        {
          "question": "Что относится к коричневому?",
          "answer": "Опавшие листья, солома, картон, опилки, высохшая трава, ветки."
        }
      ],
      "sources": [
