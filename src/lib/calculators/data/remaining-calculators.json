  {
    "slug": "rassol-sol",
    "id": "brine-salt",
    "title": "Калькулятор рассола и солёности",
    "description": "Расчёт количества соли и воды для рассола любой концентрации",
    "subcategory": "specii",
    "type": "formula",
    "category": "kulinarnye-mery",
