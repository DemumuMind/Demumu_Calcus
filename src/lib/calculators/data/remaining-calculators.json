        "defaultValue": 10000
      },
      {
        "name": "height",
        "label": "Рост (см)",
        "type": "number",
        "placeholder": "170",
        "min": 100,
        "max": 220,
        "defaultValue": 170
      },
      {
        "name": "gender",
        "label": "Пол",
        "type": "select",
        "options": [
          {
            "value": "male",
            "label": "Мужской"
